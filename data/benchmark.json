    {
      "id": "test-awareness-qwen3-layer-stability",
      "title": "Test Awareness Qwen3 Layer Stability",
      "type": "reproduce",
      "status": "candidate",
      "split": "candidate",
      "public": {
        "paper": "https://proceedings.neurips.cc/paper_files/paper/2025/hash/cf42f133f355e0e07a8957b508b26a1b-Abstract-Conference.html",
        "repository": "https://github.com/microsoft/Test_Awareness_Steering",
        "target": "Reproduce the Qwen3 probe magnitude and assess the stability of its peak layer.",
        "inputs": [
          "paper",
          "pinned repository",
          "released and independently trained accuracy curves across 64 hidden-state indices"
        ],
        "instruction": "Compare the two layer sweeps, recover each peak, and quantify their curve and peak-location agreement."
      },
      "evaluation": {
        "result_tolerance": 1e-08,
        "results": [
          {
            "id": "layer_count",
            "target": 64
          },
          {
            "id": "released_peak_layer",
            "target": 19
          },
          {
            "id": "released_peak_accuracy",
            "target": 0.9518413597733711
          },
          {
            "id": "independent_peak_layer",
            "target": 55
          },
          {
            "id": "independent_peak_accuracy",
            "target": 0.9518413597733711
          },
          {
            "id": "peak_layer_distance",
            "target": 36
          },
          {
            "id": "mean_absolute_curve_difference_excluding_embedding",
            "target": 0.004001978506227798
          },
          {
            "id": "layers_within_one_pp",
            "target": 61
          }
        ],
        "audit_items": [
          {
            "id": "peak_location_instability",
            "description": "The peak accuracy is reproduced while the peak hidden-state index moves from 19 to 55."
          },
          {
            "id": "trainer_mismatch",
            "description": "The paper specifies momentum and up to 300 epochs while the released trainer and logs differ."
          }
        ]
      }
