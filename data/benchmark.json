        "audit_items": [
          {
            "id": "published_cell_discrepancies",
            "description": "Three task-generalization cells differ from the paper by 0.16 to 0.18 AUROC."
          },
          {
            "id": "instruction_type_base_rate",
            "description": "Instruction type alone predicts success better than the best pooled probe cell."
          },
          {
            "id": "split_and_seed_mismatch",
            "description": "The released notebook uses an 80/20 split and unseeded runs while the paper states 70/30."
          },
          {
            "id": "non_native_phi3_prompt",
            "description": "The released extraction code applies the Llama-2 prompt format to Phi-3."
          },
          {
            "id": "splitwise_normalization",
            "description": "Each split is standardized using its own statistics."
          },
          {
            "id": "instruction_fold_support",
            "description": "Only four instruction-type folds are valid because one type always succeeds."
          },
          {
            "id": "token_indexing",
            "description": "The reported last-token state is off by one in the released extraction code."
          },
          {
            "id": "task_count",
            "description": "The released data contain 102 tasks rather than the reported 100."
          }
        ],
        "audit_f1_min": 0.5
      }
    },
